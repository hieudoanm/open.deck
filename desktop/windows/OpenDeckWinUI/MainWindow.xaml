<Window
    x:Class="OpenDeckWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="OpenDeck" FontSize="28" FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Status:" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Stopped" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Port:" VerticalAlignment="Center"/>
            <NumberBox x:Name="PortBox" Value="47821" Minimum="1" Maximum="65535"
                       Width="100"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Pairing token:" VerticalAlignment="Center"/>
            <TextBox x:Name="TokenBox" IsReadOnly="True" Width="160"
                     FontFamily="Cascadia Mono, Consolas"/>
            <Button x:Name="CopyButton" Content="Copy" Click="CopyButton_Click"/>
        </StackPanel>

        <Border Grid.Row="4" Width="220" Height="220" HorizontalAlignment="Left">
            <Image x:Name="QrImage" Stretch="Uniform"/>
        </Border>

        <TextBlock Grid.Row="5" TextWrapping="Wrap"
                   Text="On your phone, enter this PC's LAN IP, the port, and the pairing token. Make sure Windows Firewall allows inbound TCP on the port."/>

        <Button Grid.Row="7" x:Name="ToggleButton" Content="Start server"
                Click="ToggleButton_Click" MinWidth="140"/>
    </Grid>
</Window>
